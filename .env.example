# Copy to .env for local development. Coolify holds the production values in the
# resource's environment tab; the worker secrets live in Cloudflare, not here.

# ---------------------------------------------------------------- panel (apps/web)
APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
# openssl rand -base64 48
BETTER_AUTH_SECRET=replace-with-at-least-32-characters-of-random

# Short domain used when a workspace has no custom domain of its own.
PLATFORM_SHORT_DOMAIN=localhost:3000
# Hostname customers CNAME to (Cloudflare for SaaS fallback origin).
CUSTOM_HOSTNAME_TARGET=cname.short.app

DATABASE_URL=postgres://postgres:postgres@localhost:5432/short
# Optional. Without it the API rate limiter fails open.
REDIS_URL=redis://localhost:6379
# Prefix every Redis key so a later kisa.ly app can share the same instance.
REDIS_KEY_PREFIX=short:

CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=short

# Shared with apps/edge — the worker presents it to /api/internal/resolve.
INTERNAL_TOKEN=replace-with-32-random-characters
# Bearer token for /api/cron/*. Falls back to INTERNAL_TOKEN when unset.
CRON_SECRET=replace-with-32-random-characters

# ---------------------------------------------------------- optional integrations
# Cloudflare: custom hostnames + KV writes. All four are required together.
CF_ACCOUNT_ID=
CF_ZONE_ID=
CF_API_TOKEN=
CF_KV_NAMESPACE_ID=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Brand shown on the public landing. Each Coolify app sets its own.
PLATFORM_BRAND_NAME=Short
PLATFORM_TAGLINE=Short links, QR codes and bio pages
PLATFORM_DEFAULT_LOCALE=en

RESEND_API_KEY=
# Must be a sender on the verified Resend domain (short.ky today).
EMAIL_FROM=Short <noreply@short.ky>

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --------------------------------------------- workers (wrangler secret put, FYI)
# apps/edge:   INTERNAL_TOKEN, VISITOR_SALT
# apps/ingest: CLICKHOUSE_PASSWORD, INTERNAL_TOKEN
# VISITOR_SALT is what makes visitor_id non-reversible. Rotating it resets unique
# visitor counts from that day forward, so treat it as long-lived.
