# Copy to .env for local development. Coolify holds the production values in the
# resource's environment tab; the worker secrets live in Cloudflare, not here.

# ---------------------------------------------------------------- panel (apps/web)
# `pnpm dev` serves the panel on port 3200 (apps/web/package.json).
APP_URL=http://localhost:3200
# Marketing origin. Omit locally. In prod this is https://short.ky (derived from APP_URL by stripping app.).
# SITE_URL=https://short.ky
BETTER_AUTH_URL=http://localhost:3200
# openssl rand -base64 48
BETTER_AUTH_SECRET=replace-with-at-least-32-characters-of-random
# Envelope key for Stripe / Cloudflare secrets stored in Postgres. Rotate independently of auth.
SECRET_ENCRYPTION_KEY=replace-with-at-least-32-characters-of-random

# Short domain used when a workspace has no custom domain of its own.
PLATFORM_SHORT_DOMAIN=localhost:3200
# Hostname customers CNAME to (Cloudflare for SaaS fallback origin).
CUSTOM_HOSTNAME_TARGET=cname.short.ky

# Matches infra/compose.dev.yaml (Postgres on 127.0.0.1:55432, Redis on 127.0.0.1:56379).
DATABASE_URL=postgres://postgres:postgres@localhost:55432/short
# Optional. Connections per Node process (default 10).
# DATABASE_POOL_MAX=10
# Optional. Without it the API rate limiter fails open.
REDIS_URL=redis://localhost:56379
# Prefix every Redis key so a later kisa.ly app can share the same instance.
REDIS_KEY_PREFIX=short:

CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=short

# Shared with apps/edge — the worker presents it to /api/internal/resolve.
INTERNAL_TOKEN=replace-with-32-random-characters
# Bearer token for /api/cron/*. Falls back to INTERNAL_TOKEN when unset.
CRON_SECRET=replace-with-32-random-characters

# ---------------------------------------------------------- optional integrations
# Cloudflare: custom hostnames + KV writes. All four are required together.
CF_ACCOUNT_ID=
CF_ZONE_ID=
CF_API_TOKEN=
CF_KV_NAMESPACE_ID=
# Customer "Add with Cloudflare" consent popup. Required — there is no token-paste fallback.
CF_OAUTH_CLIENT_ID=
CF_OAUTH_CLIENT_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Brand shown on the public landing. Each Coolify app sets its own.
PLATFORM_BRAND_NAME=Short
PLATFORM_TAGLINE=Short links, QR codes and bio pages
PLATFORM_DEFAULT_LOCALE=en
# Seed only: set to 0 to hide the language switcher on first seed.
PLATFORM_LOCALE_SWITCHER=1

# Optional. Google Safe Browsing lookup for new link destinations; unset skips the check.
GOOGLE_SAFE_BROWSING_API_KEY=

# Cloudflare Email Service (transactional mail only: sign-up, reset, invites, alerts).
# Uses CF_ACCOUNT_ID above; the token needs the "Email Sending: Send" permission.
CF_EMAIL_TOKEN=
# Sender must be on one of the platform domains (short.ky, kisa.ly).
EMAIL_FROM=Short <noreply@short.ky>
# Optional Reply-To, e.g. support@short.ky
EMAIL_REPLY_TO=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Seed only: 1 overwrites plan price ids with the live short.ky Stripe catalogue.
# Leave unset for any other deployment (kisa.ly, staging, local).
# STRIPE_ATTACH_LIVE_PRICES=

# Same value as the edge worker secret — keeps bio view + click visitor_id aligned.
# VISITOR_SALT=

# --------------------------------------------- workers (wrangler secret put, FYI)
# apps/edge:   INTERNAL_TOKEN, VISITOR_SALT
# apps/ingest: CLICKHOUSE_PASSWORD, INTERNAL_TOKEN
# VISITOR_SALT is what makes visitor_id non-reversible. Rotating it resets unique
# visitor counts from that day forward, so treat it as long-lived.
